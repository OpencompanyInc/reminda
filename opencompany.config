{
  "manifest": "opencompany.config",
  "app": {
    "name": "reminda",
    "slug": "reminda",
    "framework": "nextjs"
  },
  "services": {
    "billing": {
      "provider": "stripe",
      "secrets": ["STRIPE_KEY"]
    },
    "db": {
      "provider": "platform",
      "collections": ["reminders", "users"]
    },
    "cache": {
      "provider": "platform"
    },
    "storage": {
      "provider": "platform"
    },
    "auth": {
      "provider": "platform",
      "methods": ["email", "oauth"],
      "requireAuth": true
    }
  }
}